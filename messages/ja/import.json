    {
      "declarations": [
        "input count",
        "input n",
        "input payees",
        "input p",
        "local countPlural = count: plural",
        "local payeesPlural = payees: plural"
      ],
      "selectors": ["countPlural", "payeesPlural"],
      "match": {
        "countPlural=other, payeesPlural=other": "{n}件の取引、取引先は{p}件。取引先への変更は、その取引先のすべての取引に適用されます。"
      }
    }
  ],
