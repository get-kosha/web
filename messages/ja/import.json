        "input t",
        "local countPlural = count: plural",
        "local payeesPlural = payees: plural",
        "local transfersPlural = transfers: plural"
      ],
      "selectors": ["countPlural", "payeesPlural", "transfersPlural"],
      "match": {
        "countPlural=other, payeesPlural=other, transfersPlural=other": "{n}件の取引、取引先は{p}件、口座間の振替は{t}件。取引先への変更は、その取引先のすべての取引に適用されます。"
      }
    }
