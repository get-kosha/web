  "overview_bills_before": [
    {
      "declarations": ["input count", "input day", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "{day}までに請求{count}件"
      }
    }
  ],
  "overview_others": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "ほか{count}件"
      }
    }
  ],
  "overview_att_category_sub": [
    {
      "declarations": ["input spent", "input usual", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "今の時点で{spent}（いつもは{usual}）· 支払い{count}件"
      }
    }
  ],
  "overview_att_value_age": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "{name}の評価額は{count}日前のものです"
      }
    }
  ],
  "overview_coming_then_more": [
    {
      "declarations": ["input day", "input name", "input amount", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "次は{day}：{name} {#num}{amount}{/num}、ほか{count}件 →"
      }
    }
  ]
