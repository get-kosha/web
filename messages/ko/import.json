    {
      "declarations": [
        "input count",
        "input n",
        "input payees",
        "input p",
        "local countPlural = count: plural",
        "local payeesPlural = payees: plural"
      ],
      "selectors": ["countPlural", "payeesPlural"],
      "match": {
        "countPlural=*, payeesPlural=*": "거래 {n}건, 거래처 {p}곳. 거래처를 바꾸면 그 거래처의 모든 거래에 적용돼요."
      }
    }
  ],
