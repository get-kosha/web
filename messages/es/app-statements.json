  "app_imp_check_pdf": "Compruébalo con el PDF",
  "app_imp_recurring": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pago parece recurrente",
        "countPlural=*": "{count} pagos parecen recurrentes"
      }
    }
  ],
  "app_imp_n_files": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} archivo",
        "countPlural=*": "{count} archivos"
      }
    }
  ],
  "app_imp_n_accounts": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} cuenta",
        "countPlural=*": "{count} cuentas"
      }
    }
  ],
  "app_imp_n_payees": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} beneficiario",
        "countPlural=*": "{count} beneficiarios"
      }
    }
  ],
  "app_imp_n_transfers": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} transferencia",
        "countPlural=*": "{count} transferencias"
      }
    }
  ],
  "app_imp_n_new": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} nuevo",
        "countPlural=*": "{count} nuevos"
      }
    }
  ],
  "app_imp_summary": "{transactions} en {accounts}",
  "app_imp_done_summary": "{transactions} en {accounts}.",
  "app_imp_done_summary_transfers": "{transactions} en {accounts}, con {transfers} entre ellas vinculadas."
}
