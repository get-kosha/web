  "app_rec_zip_hint": "Kosha comprime en un zip los que marques y abre el menú para compartir.",
  "app_rec_average_last": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "media del último pago",
        "countPlural=*": "media de los últimos {count}"
      }
    }
  ],
  "app_rec_backfill": [
    {
      "declarations": ["input count", "input date", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Kosha registrará los pagos desde el {date} hasta hoy: {count} pago.",
        "countPlural=*": "Kosha registrará los pagos desde el {date} hasta hoy: {count} pagos."
      }
    }
  ],
  "app_rec_payments_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pago",
        "countPlural=*": "{count} pagos"
      }
    }
  ],
  "app_rec_share_zip": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Compartir {count} en zip",
        "countPlural=*": "Compartir {count} en zip"
      }
    }
