  "overview_bills_before": [
    {
      "declarations": ["input count", "input day", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} factura antes del {day}",
        "countPlural=*": "{count} facturas antes del {day}"
      }
    }
  ],
  "overview_others": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} más",
        "countPlural=*": "{count} más"
      }
    }
  ],
  "overview_att_category_sub": [
    {
      "declarations": ["input spent", "input usual", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{spent} frente a {usual} a estas alturas · {count} pago",
        "countPlural=*": "{spent} frente a {usual} a estas alturas · {count} pagos"
      }
    }
  ],
  "overview_att_value_age": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "El valor de {name} tiene {count} día",
        "countPlural=*": "El valor de {name} tiene {count} días"
      }
    }
  ],
  "overview_coming_then_more": [
    {
      "declarations": ["input day", "input name", "input amount", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Luego el {day}: {name} {#num}{amount}{/num} y {count} más →",
        "countPlural=*": "Luego el {day}: {name} {#num}{amount}{/num} y {count} más →"
      }
    }
  ]
