  "overview_bills_before": [
    {
      "declarations": ["input count", "input day", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} платёж до {day}",
        "countPlural=few": "{count} платежа до {day}",
        "countPlural=many": "{count} платежей до {day}",
        "countPlural=other": "{count} платежа до {day}"
      }
    }
  ],
  "overview_others": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "ещё {count}"
      }
    }
  ],
  "overview_att_category_sub": [
    {
      "declarations": ["input spent", "input usual", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{spent} против обычных {usual} к этому дню · {count} платёж",
        "countPlural=few": "{spent} против обычных {usual} к этому дню · {count} платежа",
        "countPlural=many": "{spent} против обычных {usual} к этому дню · {count} платежей",
        "countPlural=other": "{spent} против обычных {usual} к этому дню · {count} платежа"
      }
    }
  ],
  "overview_att_value_age": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{name}: стоимость не обновлялась {count} день",
        "countPlural=few": "{name}: стоимость не обновлялась {count} дня",
        "countPlural=many": "{name}: стоимость не обновлялась {count} дней",
        "countPlural=other": "{name}: стоимость не обновлялась {count} дня"
      }
    }
  ],
  "overview_coming_then_more": [
    {
      "declarations": ["input day", "input name", "input amount", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "Затем {day}: {name} {#num}{amount}{/num} и ещё {count} →"
      }
    }
  ]
}
