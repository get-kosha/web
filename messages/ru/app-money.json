  "app_rec_average_last": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "в среднем за последний {count} платёж",
        "countPlural=few": "в среднем за последние {count} платежа",
        "countPlural=many": "в среднем за последние {count} платежей",
