  "app_rec_backfill": [
    {
      "declarations": ["input count", "input date", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Kosha запишет платежи с {date} по сегодняшний день: {count} платёж.",
        "countPlural=few": "Kosha запишет платежи с {date} по сегодняшний день: {count} платежа.",
