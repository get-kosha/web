  "app_imp_check_pdf": "Сверьте с PDF",
  "app_imp_recurring": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} платёж похож на регулярный",
        "countPlural=few": "{count} платежа похожи на регулярные",
        "countPlural=many": "{count} платежей похожи на регулярные",
        "countPlural=*": "{count} платежа похожи на регулярные"
      }
    }
  ],
  "app_imp_n_files": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} файл",
        "countPlural=few": "{count} файла",
        "countPlural=many": "{count} файлов",
        "countPlural=*": "{count} файла"
      }
    }
  ],
  "app_imp_n_accounts": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} счёт",
        "countPlural=few": "{count} счёта",
        "countPlural=many": "{count} счетов",
        "countPlural=*": "{count} счёта"
      }
    }
  ],
  "app_imp_n_payees": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} контрагент",
        "countPlural=few": "{count} контрагента",
        "countPlural=many": "{count} контрагентов",
        "countPlural=*": "{count} контрагента"
      }
    }
  ],
  "app_imp_n_transfers": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} перевод",
        "countPlural=few": "{count} перевода",
        "countPlural=many": "{count} переводов",
        "countPlural=*": "{count} перевода"
      }
    }
  ],
  "app_imp_n_new": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} новая",
        "countPlural=few": "{count} новые",
        "countPlural=many": "{count} новых",
        "countPlural=*": "{count} новые"
      }
    }
  ],
  "app_imp_summary": "{transactions} · {accounts}",
  "app_imp_done_summary": "{transactions} · {accounts}.",
  "app_imp_done_summary_transfers": "{transactions} · {accounts}, а также {transfers} между ними."
