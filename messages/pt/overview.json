  "overview_bills_before": [
    {
      "declarations": ["input count", "input day", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} despesa fixa antes de {day}",
        "countPlural=*": "{count} despesas fixas antes de {day}"
      }
    }
  ],
  "overview_others": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} outra",
        "countPlural=*": "{count} outras"
      }
    }
  ],
  "overview_att_category_sub": [
    {
      "declarations": ["input spent", "input usual", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{spent} vs. {usual} até agora · {count} pagamento",
        "countPlural=*": "{spent} vs. {usual} até agora · {count} pagamentos"
      }
    }
  ],
  "overview_att_value_age": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "O valor de {name} tem {count} dia",
        "countPlural=*": "O valor de {name} tem {count} dias"
      }
    }
  ],
  "overview_coming_then_more": [
    {
      "declarations": ["input day", "input name", "input amount", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Depois, {day}: {name} {#num}{amount}{/num} e mais {count} →",
        "countPlural=*": "Depois, {day}: {name} {#num}{amount}{/num} e mais {count} →"
      }
    }
  ]
