  "app_rec_zip_hint": "O Kosha compacta os que você marcar em um zip e abre o menu de compartilhamento.",
  "app_rec_average_last": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "média do último pagamento",
        "countPlural=*": "média dos últimos {count}"
      }
    }
  ],
  "app_rec_backfill": [
    {
      "declarations": ["input count", "input date", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "O Kosha vai registrar os pagamentos de {date} até hoje: {count} pagamento.",
        "countPlural=*": "O Kosha vai registrar os pagamentos de {date} até hoje: {count} pagamentos."
      }
    }
  ],
  "app_rec_payments_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pagamento",
        "countPlural=*": "{count} pagamentos"
      }
    }
  ],
  "app_rec_share_zip": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Compartilhar {count} em zip",
        "countPlural=*": "Compartilhar {count} em zip"
      }
    }
  ],
