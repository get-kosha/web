  "app_acc_fx_market": "Markt {rate}",
  "app_acc_fx_no_fee": "keine Gebühr",
  "app_acc_fx_rate": "Kurs {rate}",
  "app_acc_gain_over_in": "Gewinn über Einzahlungen",
  "app_acc_import_hint": "CSV, OFX, QFX oder PDF",
  "app_acc_import_hint_no_pdf": "CSV, OFX oder QFX",
  "app_acc_kosha_shows": "Kosha zeigt {amount}",
  "app_acc_owed": "{account}, geschuldet",
  "app_acc_reconcile_hint": "Mit einem Kontoauszug abgleichen",
  "app_acc_still_counted": "zählen weiter zum Nettovermögen",
