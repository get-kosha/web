    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} Währung",
        "countPlural=*": "{count} Währungen"
      }
    }
  ],
  "app_acc_fx_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} Wechsel",
        "countPlural=*": "{count} Wechsel"
      }
    }
  ],
  "app_acc_fx_this_year": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} dieses Jahr",
        "countPlural=*": "{count} dieses Jahr"
      }
    }
  ]
