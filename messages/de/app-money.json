  "app_rec_zip_hint": "Kosha packt die markierten in ein ZIP und öffnet das Teilen-Menü.",
  "app_rec_average_last": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Durchschnitt der letzten Zahlung",
        "countPlural=*": "Durchschnitt der letzten {count}"
      }
    }
  ],
  "app_rec_backfill": [
    {
      "declarations": ["input count", "input date", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Kosha erfasst die Zahlungen vom {date} bis heute: {count} Zahlung.",
        "countPlural=*": "Kosha erfasst die Zahlungen vom {date} bis heute: {count} Zahlungen."
      }
    }
  ],
  "app_rec_payments_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} Zahlung",
        "countPlural=*": "{count} Zahlungen"
      }
    }
  ],
  "app_rec_share_zip": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} als ZIP teilen",
        "countPlural=*": "{count} als ZIP teilen"
      }
    }
  ],
  "app_acc_credit_used": "{percent} von {limit} genutzt",
  "app_acc_debt_hint": "Das Nettovermögen zählt, was du schuldest, als Schulden.",
