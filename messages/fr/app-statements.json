{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_rcn_quick_title": "Vérification rapide",
  "app_rcn_statement_title": "Avec un relevé",
  "app_rcn_tick_off": "Cocher les opérations",
  "app_rcn_import_instead": "Importer plutôt le relevé",
