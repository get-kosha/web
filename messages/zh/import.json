    {
      "declarations": ["input count", "input n", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "{n} 笔交易"
      }
    }
  ],
  "import_done_recurring": [
    {
      "declarations": ["input count", "input n", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "Kosha 发现了 {n} 笔重复出现的付款。把它们设为定期付款吧。"
      }
    }
  ],
  "import_done_overview": "查看概览",
  "import_done_transactions": "查看交易"
