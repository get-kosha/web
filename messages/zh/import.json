    {
      "declarations": ["input count", "input n", "input from", "input to", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "{n} 行，{from} 至 {to}"
      }
    }
  ],
  "import_stmt_no_lines": "未读取到任何行",
  "import_move_label": "将 {file} 移到另一个账户",
  "import_move_placeholder": "移到…",
  "import_remove": "移除 {file}",
  "import_account_range": [
    {
      "declarations": ["input count", "input n", "input from", "input to", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "{from} 至 {to} 的 {n} 笔交易。"
      }
    }
  ],
  "import_account_dupes": [
    {
      "declarations": ["input count", "input n", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "有 {n} 行出现在多份对账单中，只计算一次。"
      }
    }
  ],
  "import_review_title": "检查交易对象和分类",
  "import_review_sub": [
    {
      "declarations": [
        "input count",
        "input n",
        "input payees",
        "input p",
        "local countPlural = count: plural",
        "local payeesPlural = payees: plural"
      ],
      "selectors": ["countPlural", "payeesPlural"],
      "match": {
        "countPlural=*, payeesPlural=*": "{n} 笔交易，涉及 {p} 个交易对象。修改某个交易对象会应用到它的所有交易。"
      }
    }
  ],
  "import_review_sub_transfers": [
    {
      "declarations": [
        "input count",
        "input n",
        "input payees",
        "input p",
        "input transfers",
        "input t",
        "local countPlural = count: plural",
        "local payeesPlural = payees: plural",
        "local transfersPlural = transfers: plural"
      ],
      "selectors": ["countPlural", "payeesPlural", "transfersPlural"],
      "match": {
        "countPlural=*, payeesPlural=*, transfersPlural=*": "{n} 笔交易，涉及 {p} 个交易对象，以及 {t} 笔你的账户之间的转账。修改某个交易对象会应用到它的所有交易。"
      }
    }
  ],
