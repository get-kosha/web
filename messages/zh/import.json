  "import_reading": "正在读取 {name}",
  "import_dismiss": "移除 {name}",
  "import_reading_files": [
    {
      "declarations": ["input count", "input n", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=*": "正在读取 {n} 个文件…"
      }
    }
  ],
  "import_summary": [
    {
      "declarations": [
        "input count",
        "input n",
        "input accounts",
        "input a",
        "local countPlural = count: plural",
        "local accountsPlural = accounts: plural"
      ],
      "selectors": ["countPlural", "accountsPlural"],
      "match": {
        "countPlural=*, accountsPlural=*": "{a} 个账户中的 {n} 笔交易"
      }
    }
  ],
  "import_check_payees": "检查交易对象",
