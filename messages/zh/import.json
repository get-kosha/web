  "import_done_summary": [
    {
      "declarations": [
        "input count",
        "input n",
        "input accounts",
        "input a",
        "local countPlural = count: plural",
        "local accountsPlural = accounts: plural"
      ],
      "selectors": ["countPlural", "accountsPlural"],
      "match": {
        "countPlural=*, accountsPlural=*": "{a} 个账户中的 {n} 笔交易。"
      }
    }
  ],
  "import_done_summary_transfers": [
    {
      "declarations": [
        "input count",
        "input n",
        "input accounts",
        "input a",
        "input transfers",
        "input t",
        "local countPlural = count: plural",
        "local accountsPlural = accounts: plural",
        "local transfersPlural = transfers: plural"
      ],
      "selectors": ["countPlural", "accountsPlural", "transfersPlural"],
      "match": {
        "countPlural=*, accountsPlural=*, transfersPlural=*": "{a} 个账户中的 {n} 笔交易，其间的 {t} 笔转账已关联。"
      }
