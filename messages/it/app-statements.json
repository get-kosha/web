  "app_imp_recurring": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pagamento sembra ricorrente",
        "countPlural=*": "{count} pagamenti sembrano ricorrenti"
      }
    }
  ],
  "app_imp_n_files": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} file",
        "countPlural=*": "{count} file"
      }
    }
  ],
  "app_imp_n_accounts": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} conto",
        "countPlural=*": "{count} conti"
      }
    }
  ],
  "app_imp_n_payees": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} beneficiario",
        "countPlural=*": "{count} beneficiari"
      }
    }
  ],
  "app_imp_n_transfers": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} trasferimento",
        "countPlural=*": "{count} trasferimenti"
      }
    }
  ],
  "app_imp_n_new": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} nuova",
        "countPlural=*": "{count} nuove"
      }
    }
  ],
  "app_imp_summary": "{transactions} in {accounts}",
  "app_imp_done_summary": "{transactions} in {accounts}.",
  "app_imp_done_summary_transfers": "{transactions} in {accounts}, con {transfers} tra loro collegati."
