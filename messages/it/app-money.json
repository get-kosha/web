  "app_rec_average_last": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "media dell'ultimo pagamento",
        "countPlural=*": "media degli ultimi {count}"
      }
    }
  ],
  "app_rec_backfill": [
    {
      "declarations": ["input count", "input date", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Kosha registrerà i pagamenti dal {date} a oggi: {count} pagamento.",
        "countPlural=*": "Kosha registrerà i pagamenti dal {date} a oggi: {count} pagamenti."
      }
    }
  ],
  "app_rec_payments_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} pagamento",
        "countPlural=*": "{count} pagamenti"
      }
