  "overview_coming_then": "Then {day}: {name} {#num}{amount}{/num} →",
  "overview_bills_before": [
    {
      "declarations": ["input count", "input day", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} bill before {day}",
        "countPlural=other": "{count} bills before {day}"
      }
    }
  ],
  "overview_others": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} other",
        "countPlural=other": "{count} others"
      }
    }
  ],
  "overview_att_category_sub": [
    {
      "declarations": ["input spent", "input usual", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{spent} vs {usual} by now · {count} payment",
        "countPlural=other": "{spent} vs {usual} by now · {count} payments"
      }
    }
  ],
  "overview_att_value_age": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{name} value is {count} day old",
        "countPlural=other": "{name} value is {count} days old"
      }
    }
  ],
  "overview_coming_then_more": [
    {
      "declarations": ["input day", "input name", "input amount", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Then {day}: {name} {#num}{amount}{/num} and {count} more →",
        "countPlural=other": "Then {day}: {name} {#num}{amount}{/num} and {count} more →"
      }
    }
  ]
