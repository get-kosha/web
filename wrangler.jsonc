{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosha",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosha",
      "database_id": "fd3854e3-8cb6-4f14-9889-59388813b0c5",
      "migrations_dir": "migrations",
    },
  ],
  // Profile pictures. R2 needs a payment card on the Cloudflare account, so it's optional: delete this
  // block to deploy without it, and Settings › Profile says photos aren't set up. With it, create the
  // bucket once with `npx wrangler r2 bucket create kosha-avatars`.
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "kosha-avatars" }],
  // Public API and MCP: 120 requests a minute per user (src/server/api.server.ts).
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // BETTER_AUTH_SECRET goes in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    // Public URL of the app. Passkeys are tied to this domain.
    "BETTER_AUTH_URL": "https://getkosha.app",
  },
}
