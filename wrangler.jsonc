{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosha",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosha",
      "database_id": "fd3854e3-8cb6-4f14-9889-59388813b0c5",
      "migrations_dir": "migrations",
    },
  ],
  // BETTER_AUTH_SECRET goes in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    // Public URL of the app. Passkeys are tied to this domain.
    "BETTER_AUTH_URL": "https://kosha.amruth-pillai.workers.dev",
    // Comma-separated emails allowed to sign up. Empty = anyone.
    "ALLOWED_EMAILS": "im.amruth@gmail.com",
  },
}
