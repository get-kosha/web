{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosha",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wraps TanStack Start's own entry with the signed-out page cache.
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // The deployed version's id, which keys the signed-out page cache in src/server.ts.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kosha",
      "database_id": "fd3854e3-8cb6-4f14-9889-59388813b0c5",
      "migrations_dir": "migrations",
    },
  ],
  // Profile pictures. R2 needs a payment card on the Cloudflare account, so it's optional: delete this
  // block to deploy without it, and Settings › Profile says photos aren't set up. With it, create the
  // bucket once with `npx wrangler r2 bucket create kosha-avatars`.
  // Receipts and payslips attached to transactions use a second bucket, ATTACHMENTS, optional in the same way:
  // create it once with `npx wrangler r2 bucket create kosha-attachments`.
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "kosha-avatars" },
    { "binding": "ATTACHMENTS", "bucket_name": "kosha-attachments" },
  ],
  // Public API and MCP: 120 requests a minute per user, and 120 more for Kosha's own apps (overLimit in src/server/api.server.ts).
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // BETTER_AUTH_SECRET goes in .dev.vars locally and `wrangler secret put` in production. So do the optional
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, which turn on Sign in with Google, APPLE_CLIENT_ID, APPLE_KEY_ID
  // and APPLE_PRIVATE_KEY (with APPLE_TEAM_ID), which turn on Sign in with Apple, and BETTER_AUTH_API_KEY,
  // which connects the Better Auth dashboard (README).
  "vars": {
    // Public URL of the app. Passkeys are tied to this domain.
    "BETTER_AUTH_URL": "https://getkosha.app",
  },
}
