{
  "name": "kosha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check",
    "typecheck": "tsrs --noEmit --fast",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "node src/lib/core.test.ts",
    "db:migrate": "wrangler d1 migrations apply kosha --local",
    "import:cashew": "node scripts/cashew-to-sql.ts",
    "db:demo": "node scripts/seed-demo.ts > .wrangler/demo.sql && wrangler d1 execute kosha --local --file .wrangler/demo.sql",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "knip": "^6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsrs": "^0.22.0-ts7.1.0-beta",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
